{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Start Syncra Server (FastAPI)",
      "type": "shell",
      "command": "python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Started server process",
          "endsPattern": "Uvicorn running on http://0.0.0.0:8000"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "2. Start Secure HTTPS Tunnel (Cloudflare)",
      "type": "shell",
      "command": ".\\cloudflared.exe tunnel --url http://127.0.0.1:8000",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Requesting new quick Tunnel",
          "endsPattern": "Your quick Tunnel has been created"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "3. Run System Diagnostic (doctor.py)",
      "type": "shell",
      "command": "python doctor.py",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "4. Open Syncra Web Dashboard",
      "type": "shell",
      "command": "Start-Process 'http://localhost:8000/app/'",
      "presentation": {
        "reveal": "silent"
      }
    }
  ]
}
