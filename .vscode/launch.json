{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "▶ Run Syncra Server (FastAPI on 0.0.0.0:8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "backend.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--reload"
      ],
      "jinja": true,
      "justMyCode": true,
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Application startup complete",
        "uriFormat": "http://localhost:8000/app/",
        "action": "openExternally"
      }
    },
    {
      "name": "▶ System Health Check (doctor.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/doctor.py",
      "console": "integratedTerminal"
    }
  ]
}
