# ── Whisper ASR ──────────────────────────────────────────────────────────────
# Model sizes: tiny, base, small, medium, large-v3
# small = fast + decent Hindi. medium/large = better quality but slower.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
# For GPU: WHISPER_DEVICE=cuda and WHISPER_COMPUTE=float16
WHISPER_COMPUTE=int8

# ── Ollama LLM ───────────────────────────────────────────────────────────────
# Recommended models (install with: ollama pull <model>):
#   llama3.1:8b       — safe default, ~5GB
#   qwen2.5:14b       — best JSON accuracy, ~9GB
#   phi4              — fast, low RAM, ~4GB
OLLAMA_MODEL=llama3.1:8b

# ── NLLB Translation ─────────────────────────────────────────────────────────
# facebook/nllb-200-distilled-600M  — 2.4GB, good speed
# facebook/nllb-200-distilled-1.3B  — 5GB, better Hinglish
NLLB_MODEL=facebook/nllb-200-distilled-600M

# ── LiveKit ──────────────────────────────────────────────────────────────────
# Run: docker compose up -d livekit
# Or download livekit-server.exe from github.com/livekit/livekit/releases
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_at_least_32_chars_long!

# ── Storage ──────────────────────────────────────────────────────────────────
# Directory for meeting records, audio files and clips
MEETINGS_DIR=meetings

# ── Cloud LLM Fallback (optional) ─────────────────────────────────────────────
# Set LLM_PROVIDER to switch from Ollama to a cloud provider:
# LLM_PROVIDER=ollama      (default — fully local)
# LLM_PROVIDER=openai      (requires: pip install openai + OPENAI_API_KEY)
# LLM_PROVIDER=gemini      (requires: pip install google-generativeai + GEMINI_API_KEY)
# LLM_PROVIDER=anthropic   (requires: pip install anthropic + ANTHROPIC_API_KEY)
LLM_PROVIDER=ollama

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Google Gemini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ── Speaker Diarization (Phase B — optional) ──────────────────────────────────
# Enable for single-file uploads with multiple speakers mixed in one channel.
# Requires: pip install pyannote.audio  +  a HuggingFace token with model access
# Grant access at: https://hf.co/pyannote/speaker-diarization-3.1
DIARIZATION_ENABLED=false
# HF_TOKEN=hf_...
# DIARIZATION_BACKEND=auto   # auto | pyannote | energy
# DIARIZATION_NUM_SPEAKERS=0  # 0 = auto-detect

# ── Authentication (optional) ──────────────────────────────────────────────────
# Enable multi-user authentication (passwords stored in SQLite with PBKDF2)
AUTH_ENABLED=false
# JWT_SECRET=change-this-to-a-random-32-char-secret-minimum
# JWT_EXPIRE_HOURS=24
# AUTH_DB_PATH=users.db

# ── Platform Connectors — Recall.ai (Phase E) ─────────────────────────────────
# Send AI recording bots into Zoom, Google Meet, or Microsoft Teams calls
# Sign up at https://app.recall.ai to get your API key
# RECALL_API_KEY=...
# RECALL_REGION=us-west-2
# RECALL_WEBHOOK_SECRET=...
